# Bot 1 (Đại Ngỗng) - project root
# Copy file này thành .env rồi điền giá trị thật.

# Bot chính hiện có
token=YOUR_BOT_1_DISCORD_TOKEN
PREFIX=?

# Danh sách ID bot TTS để ?join/!join/#join không vào trùng phòng.
TTS_BOT_IDS=BOT1_ID,BOT2_ID,BOT3_ID
# Danh sách ID bot relay được phép vào phòng voice relay khóa LangGia.
VOICE_RELAY_BOT_USER_IDS=BOT1_ID,BOT2_ID,BOT3_ID

# Voice relay chỉ chạy khi bật true.
VOICE_RELAY_ENABLED=false
VOICE_RELAY_BOT_ID=1
VOICE_RELAY_GUILD_ID=450633680000385036
VOICE_RELAY_COMMAND_PREFIX=?relay
VOICE_RELAY_ALT_PREFIXES=?vr
VOICE_RELAY_REQUIRE_ADMIN_COMMANDS=true
VOICE_RELAY_COMMAND_ADMIN_IDS=
VOICE_RELAY_VOICE_CHANNEL_ID=

# Bot 1 thường làm WebSocket hub/server cho Bot 2 và Bot 3.
VOICE_RELAY_LINK_MODE=server
VOICE_RELAY_LINK_PORT=8790
VOICE_RELAY_LINK_URL=ws://127.0.0.1:8790
VOICE_RELAY_LINK_SECRET=CHANGE_ME_SHARED_SECRET

# Supabase service key dùng cho bot đọc config và ghi status.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
